&CONTROL
  calculation   = 'md'          ! Run BOMD
  restart_mode  = 'from_scratch'
  pseudo_dir    = './pseudo'    ! This is where your PP files should be
  outdir        = './tmp'
  prefix        = 'h2o'         ! prefix for all files generated by the code
  dt            = 10.0          ! time step in Ry a.u. (~0.48 fs)
  nstep         = 2000          ! Run for ~1 ps only
  iprint        = 1             ! Write info at every MD step
/

&SYSTEM
  ibrav         = 0             ! Cell vectors given explicitly in CELL_PARAMETERS
  nat           = 3
  ntyp          = 2
  ecutwfc       = 60.0          ! Ry  (hint_high for O from pseudo-dojo)
  nosym         = .true.        ! disable symmetry during MD
/

&ELECTRONS
  electron_maxstep = 100
  conv_thr         = 1.0d-8     ! Tight convergence to make sure forces are correct
/

&IONS
  ion_dynamics      = 'verlet'          ! Verlet integrator -> NVE
  ion_velocities    = 'from_input'      ! Read velocities from input file
  ion_temperature   = 'not_controlled'  ! no thermostat (NVE)
  pot_extrapolation = 'second_order'    ! extrapolate potential -> cheaper SCF at each step
  wfc_extrapolation = 'second_order'    ! extrapolate wavefunctions
/

ATOMIC_SPECIES
  O   15.9994  O.upf
  H    1.0079  H.upf

CELL_PARAMETERS {angstrom}
  10.0   0.0   0.0
   0.0  10.0   0.0
   0.0   0.0  10.0

! Experimental geometry: d(O-H) = 0.9572 Ang, angle(H-O-H) = 104.52 deg
! Molecule centered in the box (10 Ang cubic cell), plane in xy
ATOMIC_POSITIONS {angstrom}
  O   5.000000   5.000000   5.000000
  H   5.757800   5.585100   5.000000
  H   4.242200   5.585100   5.000000

! Velocities in Ry a.u. (Bohr/(hbar/Ry)) from Maxwell-Boltzmann at 300 K,
! COM motion removed, rescaled to T = 300.00 K (seed 42, numpy).
ATOMIC_VELOCITIES
  O  -0.0002572821  -0.0000543519   0.0000927743
  H   0.0019967664  -0.0003758507  -0.0005466765
  H   0.0020873291   0.0012386328  -0.0009260225

K_POINTS {gamma}
